# FPanel: MariaDB administration via the root helper.
# Subcommands are locked explicitly (not "*"): www-data may only call
# the commands the panel actually needs. The helper validates its arguments
# itself; this is the second layer.
www-data ALL=(root) NOPASSWD: /usr/local/sbin/fpanel-dbadmin ping, \
    /usr/local/sbin/fpanel-dbadmin exists *, \
    /usr/local/sbin/fpanel-dbadmin has-user *, \
    /usr/local/sbin/fpanel-dbadmin size *, \
    /usr/local/sbin/fpanel-dbadmin create-db *, \
    /usr/local/sbin/fpanel-dbadmin drop-db *, \
    /usr/local/sbin/fpanel-dbadmin create-user *, \
    /usr/local/sbin/fpanel-dbadmin drop-user *, \
    /usr/local/sbin/fpanel-dbadmin grant *, \
    /usr/local/sbin/fpanel-dbadmin revoke *
