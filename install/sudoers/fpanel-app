# FPanel: runtime app supervision (Node.js / Python) via systemd.
# One unit fpanel-app-<name>.service per app. The helper validates the app name,
# path, and port; no free-form arguments reach systemctl.
www-data ALL=(root) NOPASSWD: /usr/local/sbin/fpanel-app ping, \
    /usr/local/sbin/fpanel-app list, \
    /usr/local/sbin/fpanel-app start *, \
    /usr/local/sbin/fpanel-app stop *, \
    /usr/local/sbin/fpanel-app restart *, \
    /usr/local/sbin/fpanel-app status *, \
    /usr/local/sbin/fpanel-app logs *, \
    /usr/local/sbin/fpanel-app remove *
