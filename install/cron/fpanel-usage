# FPanel: collect resource usage per domain (disk, bandwidth, requests).
# Runs hourly; the CLI php.ini has no time limit, so it is safe.
# www-data is enough: it can read the docroot and the nginx access log.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

37 * * * * www-data /usr/bin/php /srv/fpanel/bin/fpanel usage:collect >/dev/null 2>&1
