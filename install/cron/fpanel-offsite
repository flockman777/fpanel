# FPanel: kirim arsip backup terbaru ke bucket offsite.
# Dijalankan 1 jam setelah backup lokal (03:17), supaya arsip yang dikirim
# sama persis dengan yang sudah diverifikasi di disk.
#
# www-data cukup untuk Signature S3 dan enkripsi, tapi tidak untuk membaca
# arsip (direktori 0700 root) dan tidak untuk /etc/fpanel/offsite.conf
# yang hanya root yang boleh lihat. Karena ituaks ini lewat helper root.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

47 4 * * * root /usr/local/sbin/fpanel-offsite
