# FPanel: send the latest backup archive to the offsite bucket.
# Runs 1 hour after the local backup (03:17), so the archive sent
# is exactly the one already verified on disk.
#
# www-data is enough for S3 signing and encryption, but not for reading
# the archives (root 0700 directory) nor for /etc/fpanel/offsite.conf,
# which only root may read. That is why this action goes through the root helper.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

47 4 * * * root /usr/local/sbin/fpanel-offsite
