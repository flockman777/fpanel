# FPanel: daily backup of panel data (SQLite, /var/www, databases, config, certificates).
# Run as root; the helper handles the logic and privilege checks.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
17 3 * * * root /usr/local/sbin/fpanel-backup create 7 >>/var/log/fpanel-backup.log 2>&1
