# FPanel: prune data that keeps growing (sessions, audit log, login attempts)
# and drop nginx access logs for domains already deleted.
# Runs in the early morning when traffic is quiet, so it does not disturb traffic.
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

23 4 * * * www-data /usr/bin/php /srv/fpanel/bin/fpanel housekeeping:run >/dev/null 2>&1
