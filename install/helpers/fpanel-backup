#!/bin/bash
# FPanel helper backup & restore.
#
# Dipanggil www-data lewat sudo (lihat /etc/sudoers.d/fpanel-backup).
# Backup berisi data paling sensitif milik panel: metadata SQLite (user, domain,
# kredensial app) dan isi website user. Karena itu direktori hasil backup
# hanya untuk root (0700) dan file-nya 0600.
#
# Format: satu arsip .tar.gz per jadwal, isinya:
#   meta.json        - waktu, versi, ukuran, checksum tiap bagian
#   panel.sqlite     - snapshot konsisten dari SQLite (VACUUM INTO, bukan cp)
#   www.tar.gz       - seluruh /var/www
#   mysqldump.sql.gz - semua database non-sistem (termasuk yang dibuat lewat phpMyAdmin)
#   vhosts.tar.gz    - konfigurasi nginx situs
#   certs.tar.gz     - /etc/letsencrypt (sertifikat + private key)
set -euo pipefail

BACKUP_DIR=/var/backups/fpanel
KEEP_DEFAULT=7
MAX_AGE_DAYS=30
PAT_FILE='^fpanel-[0-9]{8}-[0-9]{6}\.tar\.gz$'

die() { echo "ERR: $*" >&2; exit 2; }
need() { [ -n "${1:-}" ] || die "argumen kurang"; }

check_name() {
  need "$1"
  [[ "$1" =~ $PAT_FILE ]] || die "nama backup tidak valid: $1"
  [ -f "$BACKUP_DIR/$1" ] || die "backup tidak ditemukan: $1"
}

ensure_dir() { install -d -o root -g root -m 0700 "$BACKUP_DIR"; }

human() { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "${1}B"; }

# ---------------------------------------------------------------- snapshot
create() {
  local keep="${1:-$KEEP_DEFAULT}"
  [[ "$keep" =~ ^[0-9]+$ ]] || die "jumlah simpanan tidak valid"
  [ "$keep" -ge 1 ] && [ "$keep" -le 100 ] || die "jumlah simpanan di luar rentang"
  ensure_dir

  local stamp archive
  stamp="$(date -u +%Y%m%d-%H%M%S)"
  archive="$BACKUP_DIR/fpanel-$stamp.tar.gz"
  # STAGE harus global, bukan local: trap EXIT dieksekusi setelah fungsi
  # create() selesai, dan variabel local sudah tidak ada lagi (set -u akan
  #roft_error "unbound variable").
  STAGE="$(mktemp -d)"
  local stage="$STAGE"

  trap 'rm -rf "${STAGE:-}"' EXIT
  echo "==> Menyiapkan snapshot panel (SQLite)"
  # VACUUM INTO, BUKAN cp: database jalan dalam mode WAL, jadi menyalin file
  # mentah bisa menghasilkan snapshot yang tidak konsisten.
  php -r '
    require "/srv/fpanel/app/bootstrap.php";
    $pdo = Fpanel\Database\Connection::pdo();
    $out = $argv[1];
    if (file_exists($out)) { unlink($out); }
    $pdo->exec("VACUUM INTO " . $pdo->quote($out));
    $chk = $pdo->query("PRAGMA integrity_check")->fetchColumn();
    if ($chk !== "ok") { fwrite(STDERR, "integrity_check: $chk\n"); exit(1); }
  ' "$stage/panel.sqlite" || die "snapshot SQLite gagal"

  echo "==> Arsipkan file website (/var/www)"
  tar -C /var/www -czf "$stage/www.tar.gz" . 2>/dev/null || die "gagal mengarsipkan /var/www"

  echo "==> Dump database MySQL/MariaDB"
  # Hanya database non-sistem. Yang dibuat lewat panel maupun lewat phpMyAdmin
  # ikut terbawa, jadi restore tidak kehilangan data pengguna.
  local dbs
  dbs="$(mariadb --batch --skip-column-names -e "
    SELECT schema_name FROM information_schema.SCHEMATA
     WHERE schema_name NOT IN ('mysql','information_schema','performance_schema','sys')
     ORDER BY schema_name")"
  {
    echo "-- FPanel backup $(date -u +%FT%TZ)"
    for d in $dbs; do
      echo "-- dump: $d"
      mariadb-dump --single-transaction --routines --events --triggers "$d"
    done
  } > "$stage/mysqldump.sql.gz.raw" 2>/dev/null || true
  gzip -9 -c "$stage/mysqldump.sql.gz.raw" > "$stage/mysqldump.sql.gz"
  rm -f "$stage/mysqldump.sql.gz.raw"

  echo "==> Arsipkan konfigurasi nginx + sertifikat"
  tar -C /etc/nginx -czf "$stage/vhosts.tar.gz" sites-available 2>/dev/null || true
  if [ -d /etc/letsencrypt ]; then
    tar -C /etc/letsencrypt -czf "$stage/certs.tar.gz" . 2>/dev/null || true
  fi

  echo "==> Tulis metadata + checksum"
  {
    printf '{\n'
    printf '  "created_utc": "%s",\n' "$(date -u +%FT%TZ)"
    printf '  "host": "%s",\n' "$(hostname)"
    printf '  "php": "%s",\n' "$(php -r 'echo PHP_VERSION;' 2>/dev/null || echo '?')"
    printf '  "panel_db_size": %s,\n' "$(stat -c %s "$stage/panel.sqlite")"
    printf '  "www_size": %s,\n' "$(stat -c %s "$stage/www.tar.gz")"
    printf '  "mysql_size": %s,\n' "$(stat -c %s "$stage/mysqldump.sql.gz")"
    printf '  "databases": ['
    local first=1
    for d in $dbs; do
      [ $first -eq 1 ] || printf ','
      printf '"%s"' "$d"
      first=0
    done
    printf '],\n'
    printf '  "parts_sha256": {\n'
    local p sep=''
    for p in panel.sqlite www.tar.gz mysqldump.sql.gz vhosts.tar.gz certs.tar.gz; do
      [ -f "$stage/$p" ] || continue
      printf '%s    "%s": "%s"' "$sep" "$p" "$(sha256sum "$stage/$p" | cut -d' ' -f1)"
      sep=$',\n'
    done
    printf '\n  }\n}\n'
  } > "$stage/meta.json"

  echo "==> Membuat arsip"
  local members=(panel.sqlite www.tar.gz mysqldump.sql.gz meta.json)
  [ -f "$stage/vhosts.tar.gz" ] && members+=(vhosts.tar.gz)
  [ -f "$stage/certs.tar.gz" ]  && members+=(certs.tar.gz)
  tar -C "$stage" -czf "$archive.tmp" "${members[@]}"
  chmod 0600 "$archive.tmp"
  mv -f "$archive.tmp" "$archive"

  # Arsip harus benar-benar bisa dibuka. Kalau tidak, hapus jangan disimpan.
  if ! tar -tzf "$archive" >/dev/null 2>&1; then
    rm -f "$archive"
    die "arsip tidak bisa dibaca setelah dibuat; dibuang"
  fi

  local size
  size="$(stat -c %s "$archive")"
  echo "OK backup selesai: $(basename "$archive") ($(human "$size"))"

  prune "$keep"
  echo "$archive"
}

# ------------------------------------------------------------------ retensi
prune() {
  local keep="${1:-$KEEP_DEFAULT}"
  ensure_dir
  local total=0 old
  # Buang yang sudah tua
  find "$BACKUP_DIR" -maxdepth 1 -name 'fpanel-*.tar.gz' -mtime "+$MAX_AGE_DAYS" -print -delete 2>/dev/null || true
  # Buang yang paling lama, sisakan $keep terbaru
  total="$(find "$BACKUP_DIR" -maxdepth 1 -name 'fpanel-*.tar.gz' | wc -l)"
  if [ "$total" -gt "$keep" ]; then
    local n=$((total - keep))
    for old in $(find "$BACKUP_DIR" -maxdepth 1 -name 'fpanel-*.tar.gz' | sort | head -n "$n"); do
      rm -f "$old"
      echo "  :: kedaluwarsa dihapus: $(basename "$old")"
    done
  fi
}

# -------------------------------------------------------------------- daftar
list() {
  ensure_dir
  printf 'nama\tdibuat_utc\tukuran\n'
  find "$BACKUP_DIR" -maxdepth 1 -name 'fpanel-*.tar.gz' | sort | while read -r f; do
    printf '%s\t%s\t%s\n' \
      "$(basename "$f")" \
      "$(date -u -r "$f" +%FT%TZ)" \
      "$(stat -c %s "$f")"
  done
}

# ---------------------------------------------------------------- verifikasi
verify() {
  check_name "$1"
  local f="$BACKUP_DIR/$1"
  echo "arsip   : $1 ($(human "$(stat -c %s "$f")"))"
  if ! tar -tzf "$f" >/dev/null 2>&1; then
    echo "HASIL   : GAGAL - arsip tidak bisa dibuka"
    exit 1
  fi
  echo "  arsip terbaca : ya"
  local parts
  parts="$(tar -tzf "$f")"
  # Sama seperti create(): tmp harus global, bukan local, supaya trap EXIT
  # tidak gagal dengan "unbound variable".
  TMPV="$(mktemp -d)"
  local tmp="$TMPV"
  trap 'rm -rf "${TMPV:-}"' EXIT
  tar -xzf "$f" -C "$tmp" meta.json 2>/dev/null || true
  if [ -f "$tmp/meta.json" ]; then
    echo "  meta.json     : ada"
    # Cocokkan checksum tiap bagian dengan yang tercatat saat backup dibuat.
    local p sum want bad=0
    # Catat ke file dulu: while di process substitution jalan di subshell, jadi
    # `exit 1` di dalamnya tidak akan menghentikan skrip verify.
    php -r '
      $m = json_decode(file_get_contents($argv[1]), true);
      foreach (($m["parts_sha256"] ?? []) as $k => $v) { echo $k, "\t", $v, "\n"; }
    ' "$tmp/meta.json" > "$tmp/sums.txt" 2>/dev/null || : > "$tmp/sums.txt"
    while IFS=$'\t' read -r p want; do
      [ -n "${p:-}" ] || continue
      tar -xzf "$f" -C "$tmp" "$p" 2>/dev/null || continue
      sum="$(sha256sum "$tmp/$p" | cut -d' ' -f1)"
      if [ "$sum" = "$want" ]; then
        echo "  checksum $p : ok"
      else
        echo "  checksum $p : RUSAK"
        bad=1
      fi
    done < "$tmp/sums.txt"
    [ "$bad" = "0" ] || exit 1
  else
    echo "  meta.json     : TIDAK ADA"
  fi
  tar -xzf "$f" -C "$tmp" panel.sqlite 2>/dev/null || true
  if [ -f "$tmp/panel.sqlite" ]; then
    local chk
    chk="$(php -r '
      try {
        $p = new PDO("sqlite:" . $argv[1]);
        echo $p->query("PRAGMA integrity_check")->fetchColumn();
      } catch (Throwable $e) { echo "err:" . $e->getMessage(); }
    ' "$tmp/panel.sqlite" 2>/dev/null)"
    echo "  sqlite integrity_check : $chk"
    [ "$chk" = "ok" ] || exit 1
  fi
  echo "HASIL   : OK"
}

# ------------------------------------------------------------------- hapus
delete_one() {
  check_name "$1"
  rm -f "$BACKUP_DIR/$1"
  echo "OK $1 dihapus"
}

# ------------------------------------------------------------------- offsite
# Arsip ada di direktori 0700 root, jadi www-data tidak bisa membacanya. Aksi
# kirim ke bucket offsite harus lewat helper root ini, yang lalu mendelegasikan
# signature S3 dan enkripsi ke CLI panel.
push() {
  local name="${1:-}"
  check_name "$name"
  exec /usr/bin/php /srv/fpanel/bin/fpanel offsite:upload "$name"
}

# ------------------------------------------------------------------ restore
restore() {
  local name="${1:-}"
  local confirm="${2:-}"
  check_name "$name"
  local f="$BACKUP_DIR/$name"

  # Restore menimpa data yang sedang hidup. Karena itu butuh konfirmasi yang
  # persis sama dengan nama file, dan sebelum menimpa selalu dibuat snapshot
  # pengaman supaya mistakes bisa dibatalkan.
  if [ "$confirm" != "$name" ]; then
    echo "Restore perlu konfirmasi. Ulangi dengan:"
    echo "  fpanel-backup restore $name $name"
    exit 3
  fi

  echo "==> Verifikasi arsip dulu"
  verify "$name" >/dev/null || die "arsip tidak lolos verifikasi, restore dibatalkan"

  echo "==> Snapshot pengaman sebelum menimpa"
  local safety
  safety="$(create "$KEEP_DEFAULT" | tail -1)"
  echo "  snapshot pengaman: $(basename "$safety")"

  TMPR="$(mktemp -d)"
  local tmp="$TMPR"
  trap 'rm -rf "${TMPR:-}"' EXIT
  tar -xzf "$f" -C "$tmp"

  echo "==> Restore database panel"
  [ -f "$tmp/panel.sqlite" ] || die "panel.sqlite tidak ada di arsip"
  # Matikan sementara supaya tidak ada proses yang menulis sambil ditimpa.
  systemctl stop php8.3-fpm >/dev/null 2>&1 || true
  cp -a "$tmp/panel.sqlite" /srv/fpanel/var/db/fpanel.sqlite.new
  rm -f /srv/fpanel/var/db/fpanel.sqlite-wal /srv/fpanel/var/db/fpanel.sqlite-shm
  mv -f /srv/fpanel/var/db/fpanel.sqlite.new /srv/fpanel/var/db/fpanel.sqlite
  chown www-data:www-data /srv/fpanel/var/db/fpanel.sqlite
  chmod 0644 /srv/fpanel/var/db/fpanel.sqlite

  echo "==> Restore file website"
  if [ -f "$tmp/www.tar.gz" ]; then
    mkdir -p /var/www
    tar -xzf "$tmp/www.tar.gz" -C /var/www
    chown -R www-data:www-data /var/www
  fi

  echo "==> Restore database MySQL"
  if [ -f "$tmp/mysqldump.sql.gz" ]; then
    gunzip -c "$tmp/mysqldump.sql.gz" | mariadb --default-character-set=utf8mb4
  fi

  echo "==> Restore konfigurasi nginx + sertifikat"
  [ -f "$tmp/vhosts.tar.gz" ] && tar -xzf "$tmp/vhosts.tar.gz" -C /etc/nginx || true
  if [ -f "$tmp/certs.tar.gz" ]; then
    # letsencrypt tidak boleh diganti seluruhnya sembarangan; hanya isi yang
    # belum ada yang ditimpa supaya certbot tetap bisa menulis.
    mkdir -p /etc/letsencrypt
    tar -xzf "$tmp/certs.tar.gz" -C /etc/letsencrypt --skip-old-files 2>/dev/null || true
  fi

  echo "==> Muat ulang layanan"
  systemctl start php8.3-fpm >/dev/null 2>&1 || systemctl restart php8.3-fpm
  if nginx -t >/dev/null 2>&1; then
    systemctl reload nginx
  else
    echo "PERINGATAN: konfigurasi nginx tidak valid, reload dilewati"
  fi

  echo "OK restore selesai dari $name"
  echo "Snapshot pengaman tersedia di: $safety"
}

cmd="${1:-}"
case "$cmd" in
  create) shift || true; create "${1:-$KEEP_DEFAULT}" ;;
  list)    shift || true; list ;;
  verify)  shift || true; need "${1:-}"; verify "$1" ;;
  delete)  shift || true; need "${1:-}"; delete_one "$1" ;;
  prune)   shift || true; prune "${1:-$KEEP_DEFAULT}" ;;
  push)    shift || true; push "${1:-}" ;;
  restore) shift || true; restore "${1:-}" "${2:-}" ;;
  ping)    echo OK ;;
  *)
    echo "ERR: subcommand tidak dikenal: '$cmd'" >&2
    echo "ERR: yang valid: create|list|verify|delete|prune|push|restore|ping" >&2
    exit 2
    ;;
esac