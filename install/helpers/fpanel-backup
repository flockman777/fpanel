#!/bin/bash
# FPanel backup & restore helper.
#
# Called by www-data through sudo (see /etc/sudoers.d/fpanel-backup).
# A backup holds the panel's most sensitive data: SQLite metadata (users, domains,
# app credentials) and the contents of user websites. That is why the backup
# directory is root-only (0700) and its files are 0600.
#
# Format: one .tar.gz archive per schedule run, containing:
#   meta.json        - time, version, size, checksum of each part
#   panel.sqlite     - consistent snapshot of SQLite (VACUUM INTO, not cp)
#   www.tar.gz       - the whole /var/www
#   mysqldump.sql.gz - all non-system databases (including those created through phpMyAdmin)
#   vhosts.tar.gz    - site nginx configuration
#   certs.tar.gz     - /etc/letsencrypt (certificates + private keys)
set -euo pipefail

BACKUP_DIR=/var/backups/fpanel
KEEP_DEFAULT=7
MAX_AGE_DAYS=30
PAT_FILE='^fpanel-[0-9]{8}-[0-9]{6}\.tar\.gz$'

die() { echo "ERR: $*" >&2; exit 2; }
need() { [ -n "${1:-}" ] || die "missing argument"; }

check_name() {
  need "$1"
  [[ "$1" =~ $PAT_FILE ]] || die "invalid backup name: $1"
  [ -f "$BACKUP_DIR/$1" ] || die "backup not found: $1"
}

ensure_dir() { install -d -o root -g root -m 0700 "$BACKUP_DIR"; }

human() { numfmt --to=iec --suffix=B "$1" 2>/dev/null || echo "${1}B"; }

# ---------------------------------------------------------------- snapshot
create() {
  local keep="${1:-$KEEP_DEFAULT}"
  [[ "$keep" =~ ^[0-9]+$ ]] || die "invalid keep count"
  [ "$keep" -ge 1 ] && [ "$keep" -le 100 ] || die "keep count out of range"
  ensure_dir

  local stamp archive
  stamp="$(date -u +%Y%m%d-%H%M%S)"
  archive="$BACKUP_DIR/fpanel-$stamp.tar.gz"
  # STAGE must be global, not local: the EXIT trap runs after the create()
  # function has finished, and local variables no longer exist (set -u will
  #fail with "unbound variable").
  STAGE="$(mktemp -d)"
  local stage="$STAGE"

  trap 'rm -rf "${STAGE:-}"' EXIT
  echo "==> Preparing the panel snapshot (SQLite)"
  # VACUUM INTO, NOT cp: the database runs in WAL mode, so copying the raw
  # file could produce an inconsistent snapshot.
  php -r '
    require "/srv/fpanel/app/bootstrap.php";
    $pdo = Fpanel\Database\Connection::pdo();
    $out = $argv[1];
    if (file_exists($out)) { unlink($out); }
    $pdo->exec("VACUUM INTO " . $pdo->quote($out));
    $chk = $pdo->query("PRAGMA integrity_check")->fetchColumn();
    if ($chk !== "ok") { fwrite(STDERR, "integrity_check: $chk\n"); exit(1); }
  ' "$stage/panel.sqlite" || die "SQLite snapshot failed"

  echo "==> Archiving website files (/var/www)"
  tar -C /var/www -czf "$stage/www.tar.gz" . 2>/dev/null || die "failed to archive /var/www"

  echo "==> Dumping MySQL/MariaDB databases"
  # Non-system databases only. Databases created through the panel as well as
  # through phpMyAdmin are included, so a restore does not lose user data.
  local dbs
  dbs="$(mariadb --batch --skip-column-names -e "
    SELECT schema_name FROM information_schema.SCHEMATA
     WHERE schema_name NOT IN ('mysql','information_schema','performance_schema','sys')
     ORDER BY schema_name")"
  {
    echo "-- FPanel backup $(date -u +%FT%TZ)"
    for d in $dbs; do
      echo "-- dump: $d"
      mariadb-dump --single-transaction --routines --events --triggers "$d"
    done
  } > "$stage/mysqldump.sql.gz.raw" 2>/dev/null || true
  gzip -9 -c "$stage/mysqldump.sql.gz.raw" > "$stage/mysqldump.sql.gz"
  rm -f "$stage/mysqldump.sql.gz.raw"

  echo "==> Archiving nginx config + certificates"
  tar -C /etc/nginx -czf "$stage/vhosts.tar.gz" sites-available 2>/dev/null || true
  if [ -d /etc/letsencrypt ]; then
    tar -C /etc/letsencrypt -czf "$stage/certs.tar.gz" . 2>/dev/null || true
  fi

  echo "==> Writing metadata + checksums"
  {
    printf '{\n'
    printf '  "created_utc": "%s",\n' "$(date -u +%FT%TZ)"
    printf '  "host": "%s",\n' "$(hostname)"
    printf '  "php": "%s",\n' "$(php -r 'echo PHP_VERSION;' 2>/dev/null || echo '?')"
    printf '  "panel_db_size": %s,\n' "$(stat -c %s "$stage/panel.sqlite")"
    printf '  "www_size": %s,\n' "$(stat -c %s "$stage/www.tar.gz")"
    printf '  "mysql_size": %s,\n' "$(stat -c %s "$stage/mysqldump.sql.gz")"
    printf '  "databases": ['
    local first=1
    for d in $dbs; do
      [ $first -eq 1 ] || printf ','
      printf '"%s"' "$d"
      first=0
    done
    printf '],\n'
    printf '  "parts_sha256": {\n'
    local p sep=''
    for p in panel.sqlite www.tar.gz mysqldump.sql.gz vhosts.tar.gz certs.tar.gz; do
      [ -f "$stage/$p" ] || continue
      printf '%s    "%s": "%s"' "$sep" "$p" "$(sha256sum "$stage/$p" | cut -d' ' -f1)"
      sep=$',\n'
    done
    printf '\n  }\n}\n'
  } > "$stage/meta.json"

  echo "==> Creating the archive"
  local members=(panel.sqlite www.tar.gz mysqldump.sql.gz meta.json)
  [ -f "$stage/vhosts.tar.gz" ] && members+=(vhosts.tar.gz)
  [ -f "$stage/certs.tar.gz" ]  && members+=(certs.tar.gz)
  tar -C "$stage" -czf "$archive.tmp" "${members[@]}"
  chmod 0600 "$archive.tmp"
  mv -f "$archive.tmp" "$archive"

  # The archive must really be openable. If not, delete it, do not keep it.
  if ! tar -tzf "$archive" >/dev/null 2>&1; then
    rm -f "$archive"
    die "the archive cannot be read after creation; discarded"
  fi

  local size
  size="$(stat -c %s "$archive")"
  echo "OK backup finished: $(basename "$archive") ($(human "$size"))"

  prune "$keep"
  echo "$archive"
}

# ----------------------------------------------------------------- retention
prune() {
  local keep="${1:-$KEEP_DEFAULT}"
  ensure_dir
  local total=0 old
  # Drop the ones that are too old
  find "$BACKUP_DIR" -maxdepth 1 -name 'fpanel-*.tar.gz' -mtime "+$MAX_AGE_DAYS" -print -delete 2>/dev/null || true
  # Drop the oldest ones, keep the $keep newest
  total="$(find "$BACKUP_DIR" -maxdepth 1 -name 'fpanel-*.tar.gz' | wc -l)"
  if [ "$total" -gt "$keep" ]; then
    local n=$((total - keep))
    for old in $(find "$BACKUP_DIR" -maxdepth 1 -name 'fpanel-*.tar.gz' | sort | head -n "$n"); do
      rm -f "$old"
      echo "  :: expired removed: $(basename "$old")"
    done
  fi
}

# ---------------------------------------------------------------------- list
list() {
  ensure_dir
  printf 'name\tcreated_utc\tsize\n'
  find "$BACKUP_DIR" -maxdepth 1 -name 'fpanel-*.tar.gz' | sort | while read -r f; do
    printf '%s\t%s\t%s\n' \
      "$(basename "$f")" \
      "$(date -u -r "$f" +%FT%TZ)" \
      "$(stat -c %s "$f")"
  done
}

# -------------------------------------------------------------- verification
verify() {
  check_name "$1"
  local f="$BACKUP_DIR/$1"
  echo "archive : $1 ($(human "$(stat -c %s "$f")"))"
  if ! tar -tzf "$f" >/dev/null 2>&1; then
    echo "RESULT  : FAILED - the archive cannot be opened"
    exit 1
  fi
  echo "  archive readable : yes"
  local parts
  parts="$(tar -tzf "$f")"
  # Same as create(): tmp must be global, not local, so the EXIT trap does
  # not fail with "unbound variable".
  TMPV="$(mktemp -d)"
  local tmp="$TMPV"
  trap 'rm -rf "${TMPV:-}"' EXIT
  tar -xzf "$f" -C "$tmp" meta.json 2>/dev/null || true
  if [ -f "$tmp/meta.json" ]; then
    echo "  meta.json     : present"
    # Match each part checksum against the one recorded when the backup was made.
    local p sum want bad=0
    # Record to a file first: the while loop in a process substitution runs in a subshell, so
    # an `exit 1` inside it will not stop the verify script.
    php -r '
      $m = json_decode(file_get_contents($argv[1]), true);
      foreach (($m["parts_sha256"] ?? []) as $k => $v) { echo $k, "\t", $v, "\n"; }
    ' "$tmp/meta.json" > "$tmp/sums.txt" 2>/dev/null || : > "$tmp/sums.txt"
    while IFS=$'\t' read -r p want; do
      [ -n "${p:-}" ] || continue
      tar -xzf "$f" -C "$tmp" "$p" 2>/dev/null || continue
      sum="$(sha256sum "$tmp/$p" | cut -d' ' -f1)"
      if [ "$sum" = "$want" ]; then
        echo "  checksum $p : ok"
      else
        echo "  checksum $p : CORRUPT"
        bad=1
      fi
    done < "$tmp/sums.txt"
    [ "$bad" = "0" ] || exit 1
  else
    echo "  meta.json     : MISSING"
  fi
  tar -xzf "$f" -C "$tmp" panel.sqlite 2>/dev/null || true
  if [ -f "$tmp/panel.sqlite" ]; then
    local chk
    chk="$(php -r '
      try {
        $p = new PDO("sqlite:" . $argv[1]);
        echo $p->query("PRAGMA integrity_check")->fetchColumn();
      } catch (Throwable $e) { echo "err:" . $e->getMessage(); }
    ' "$tmp/panel.sqlite" 2>/dev/null)"
    echo "  sqlite integrity_check : $chk"
    [ "$chk" = "ok" ] || exit 1
  fi
  echo "RESULT  : OK"
}

# ------------------------------------------------------------------ delete
delete_one() {
  check_name "$1"
  rm -f "$BACKUP_DIR/$1"
  echo "OK $1 deleted"
}

# ------------------------------------------------------------------- offsite
# Archives live in a root 0700 directory, so www-data cannot read them. The
# offsite bucket push must go through this root helper, which then delegates
# S3 signing and encryption to the panel CLI.
push() {
  local name="${1:-}"
  check_name "$name"
  exec /usr/bin/php /srv/fpanel/bin/fpanel offsite:upload "$name"
}

# ------------------------------------------------------------------ restore
restore() {
  local name="${1:-}"
  local confirm="${2:-}"
  check_name "$name"
  local f="$BACKUP_DIR/$name"

  # Restore overwrites live data. That is why it needs a confirmation that is
  # exactly the file name, and before overwriting a safety snapshot is always
  # created so mistakes can be undone.
  if [ "$confirm" != "$name" ]; then
    echo "Restore needs confirmation. Repeat with:"
    echo "  fpanel-backup restore $name $name"
    exit 3
  fi

  echo "==> Verifying the archive first"
  verify "$name" >/dev/null || die "the archive did not pass verification, restore cancelled"

  echo "==> Safety snapshot before overwriting"
  local safety
  safety="$(create "$KEEP_DEFAULT" | tail -1)"
  echo "  safety snapshot: $(basename "$safety")"

  TMPR="$(mktemp -d)"
  local tmp="$TMPR"
  trap 'rm -rf "${TMPR:-}"' EXIT
  tar -xzf "$f" -C "$tmp"

  echo "==> Restoring the panel database"
  [ -f "$tmp/panel.sqlite" ] || die "panel.sqlite is not in the archive"
  # Stop it temporarily so no process writes while it is being overwritten.
  systemctl stop php8.3-fpm >/dev/null 2>&1 || true
  cp -a "$tmp/panel.sqlite" /srv/fpanel/var/db/fpanel.sqlite.new
  rm -f /srv/fpanel/var/db/fpanel.sqlite-wal /srv/fpanel/var/db/fpanel.sqlite-shm
  mv -f /srv/fpanel/var/db/fpanel.sqlite.new /srv/fpanel/var/db/fpanel.sqlite
  chown www-data:www-data /srv/fpanel/var/db/fpanel.sqlite
  chmod 0644 /srv/fpanel/var/db/fpanel.sqlite

  echo "==> Restoring website files"
  if [ -f "$tmp/www.tar.gz" ]; then
    mkdir -p /var/www
    tar -xzf "$tmp/www.tar.gz" -C /var/www
    chown -R www-data:www-data /var/www
  fi

  echo "==> Restoring MySQL databases"
  if [ -f "$tmp/mysqldump.sql.gz" ]; then
    gunzip -c "$tmp/mysqldump.sql.gz" | mariadb --default-character-set=utf8mb4
  fi

  echo "==> Restoring nginx config + certificates"
  [ -f "$tmp/vhosts.tar.gz" ] && tar -xzf "$tmp/vhosts.tar.gz" -C /etc/nginx || true
  if [ -f "$tmp/certs.tar.gz" ]; then
    # letsencrypt must not be replaced wholesale; only entries that are
    # not there yet are overwritten so certbot can keep writing.
    mkdir -p /etc/letsencrypt
    tar -xzf "$tmp/certs.tar.gz" -C /etc/letsencrypt --skip-old-files 2>/dev/null || true
  fi

  echo "==> Reloading services"
  systemctl start php8.3-fpm >/dev/null 2>&1 || systemctl restart php8.3-fpm
  if nginx -t >/dev/null 2>&1; then
    systemctl reload nginx
  else
    echo "WARNING: the nginx config is not valid, reload skipped"
  fi

  echo "OK restore finished from $name"
  echo "Safety snapshot available at: $safety"
}

cmd="${1:-}"
case "$cmd" in
  create) shift || true; create "${1:-$KEEP_DEFAULT}" ;;
  list)    shift || true; list ;;
  verify)  shift || true; need "${1:-}"; verify "$1" ;;
  delete)  shift || true; need "${1:-}"; delete_one "$1" ;;
  prune)   shift || true; prune "${1:-$KEEP_DEFAULT}" ;;
  push)    shift || true; push "${1:-}" ;;
  restore) shift || true; restore "${1:-}" "${2:-}" ;;
  ping)    echo OK ;;
  *)
    echo "ERR: unknown subcommand: '$cmd'" >&2
    echo "ERR: valid ones: create|list|verify|delete|prune|push|restore|ping" >&2
    exit 2
    ;;
esac