#!/bin/bash
# FPanel helper: supervision of app runtimes (Node.js / Python).
#
# Each app becomes one systemd unit: fpanel-app-<name>.service
# Called by www-data through sudo (see /etc/sudoers.d/fpanel-app).
#
# Why systemd and not pm2:
#   - native to this server, no extra daemon that has to be saved
#     so it comes back after a reboot;
#   - logs are available through journalctl;
#   - start/stop/status with one clear command.
#
# Every argument is validated strictly here. The unit name is assembled from the app name,
# so the app name MUST already have passed validation (^[a-z0-9][a-z0-9_-]{1,30}$)
# before touching systemd.
set -euo pipefail

PAT_NAME='^[a-z0-9][a-z0-9_-]{1,30}$'
PAT_PATH='^[A-Za-z0-9._/-]+$'
PAT_PORT='^[0-9]{4,5}$'
PAT_ENTRY='^[A-Za-z0-9._/-]+$'
PAT_INT='^[0-9]+$'
UNIT_PREFIX=fpanel-app-

die() { echo "ERR: $*" >&2; exit 2; }

need() { [ -n "${1:-}" ] || die "missing argument"; }

check_name() {
  need "$1"
  [[ "$1" =~ $PAT_NAME ]] || die "invalid app name: $1"
}

# App folder: absolute, without "..".
check_path() {
  need "$1"
  [[ "$1" =~ $PAT_PATH ]] || die "invalid path"
  [[ "$1" == /* ]] || die "the path must be absolute"
  [[ ! "$1" =~ \.\. ]] || die "the path must not contain .."
}

# Entry file: RELATIVE to the app folder, without "..". A relative path is
# correct here; check_path must not be used for the entry because the entry is not absolute.
check_entry() {
  need "$1"
  [[ "$1" =~ $PAT_ENTRY ]] || die "invalid entry"
  [[ "$1" != /* ]] || die "the entry must be relative to the app folder"
  [[ ! "$1" =~ \.\. ]] || die "the entry must not contain .."
}

check_port() {
  need "$1"
  [[ "$1" =~ $PAT_PORT ]] || die "invalid port"
  [ "$1" -ge 1024 ] && [ "$1" -le 65535 ] || die "port out of range"
}

unit_name() { echo "${UNIT_PREFIX}$1.service"; }

write_unit() {
  local name="$1" kind="$2" root="$3" entry="$4" port="$5" home="$6"
  local unit; unit="$(unit_name "$name")"
  local file="/etc/systemd/system/$unit"
  local workdir exec

  if [ "$kind" = "node" ]; then
    workdir="$root"
    exec="/usr/bin/node $root/$entry"
  else
    workdir="$root"
    # Use python from the app's virtualenv when present; this is what lets a
    # Python app have its own dependencies without touching the system.
    local py=""
    for cand in "$root/.venv/bin/python3" "$root/venv/bin/python3" "/var/www/.venv/bin/python3" "/usr/bin/python3"; do
      if [ -x "$cand" ]; then py="$cand"; break; fi
    done
    [ -n "$py" ] || die "no python found for app $name"
    if command -v gunicorn3 >/dev/null 2>&1; then G=gunicorn3; else G=gunicorn; fi
    exec="$py -m gunicorn --chdir $root --bind 127.0.0.1:$port --workers 2 --timeout 60 wsgi:application"
  fi

  cat > "$file" <<UNIT
[Unit]
Description=FPanel app: $name ($kind)
After=network.target
# StartLimit MUST be written in [Unit], not [Service]. In the wrong section,
# systemd refuses to load the unit on daemon-reload, so an app that was
# running dies along with it without a clear error in the panel log.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=$workdir
Environment=PORT=$port
Environment=NODE_ENV=production
Environment=HOME=$home
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=$exec
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fpanel-app-$name

[Install]
WantedBy=multi-user.target
UNIT
  chmod 0644 "$file"
  systemctl daemon-reload
  echo "unit written: $unit"
}

cmd="${1:-}"
shift || true

case "$cmd" in
  start)
    check_name "${1:-}"; NAME="$1"; shift
    check_path "${1:-}"; ROOT="$1"; shift
    check_entry "${1:-}"; ENTRY="$1"; shift
    check_port "${1:-}"; PORT="$1"; shift
    KIND="${1:-}"; shift || true
    HOME_DIR="${1:-/var/www}"
    [ -d "$ROOT" ] || die "the app folder does not exist: $ROOT"
    [ -f "$ROOT/$ENTRY" ] || die "the entry does not exist: $ROOT/$ENTRY"
    case "$KIND" in node|python) ;; *) die "invalid kind: $KIND" ;; esac
    # The port must really not be in use by another app.
    if ss -ltn 2>/dev/null | awk 'NR>1{print $4}' | sed 's/.*://' | grep -qx "$PORT"; then
      die "port $PORT is already in use by another process"
    fi
    write_unit "$NAME" "$KIND" "$ROOT" "$ENTRY" "$PORT" "$HOME_DIR"
    systemctl enable "$(unit_name "$NAME")" >/dev/null 2>&1 || true
    systemctl restart "$(unit_name "$NAME")"
    sleep 1
    if systemctl is-active --quiet "$(unit_name "$NAME")"; then
      echo "OK app $NAME running at 127.0.0.1:$PORT"
    else
      echo "FAILED: app $NAME will not start" >&2
      journalctl -u "$(unit_name "$NAME")" -n 15 --no-pager 2>/dev/null | sed 's/^/  /' >&2
      exit 1
    fi
    ;;

  stop)
    check_name "${1:-}"
    systemctl stop "$(unit_name "$1")" >/dev/null 2>&1 || true
    echo "OK app $1 stopped"
    ;;

  restart)
    check_name "${1:-}"
    systemctl restart "$(unit_name "$1")"
    echo "OK app $1 restarted"
    ;;

  status)
    check_name "${1:-}"
    U="$(unit_name "$1")"
    if systemctl is-active --quiet "$U"; then echo "running"; else echo "stopped"; fi
    ;;

  logs)
    check_name "${1:-}"
    N="${2:-60}"
    [[ "$N" =~ $PAT_INT ]] || die "invalid number of lines"
    journalctl -u "$(unit_name "$1")" -n "$N" --no-pager 2>/dev/null || true
    ;;

  remove)
    check_name "${1:-}"
    U="$(unit_name "$1")"
    systemctl stop "$U" >/dev/null 2>&1 || true
    systemctl disable "$U" >/dev/null 2>&1 || true
    rm -f "/etc/systemd/system/$U"
    systemctl daemon-reload
    echo "OK app $1 removed"
    ;;

  list)
    systemctl list-units --type=service --no-legend --no-pager \
      | awk '$1 ~ /^fpanel-app-/ {print $1, $3, $4}' || true
    ;;

  ping)
    echo OK
    ;;

  *)
    echo "ERR: unknown subcommand: '$cmd'" >&2
    echo "ERR: valid ones: start|stop|restart|status|logs|remove|list|ping" >&2
    exit 2
    ;;
esac