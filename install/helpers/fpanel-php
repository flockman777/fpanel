#!/bin/bash
# FPanel helper administrasi extension PHP.
#
# Dipanggil www-data lewat sudo (lihat /etc/sudoers.d/fpanel-php).
# Extension PHP dimuat/tidak dari file .ini di conf.d, dan perubahan baru
# berlaku setelah pool FPM versi itu di-restart. Karena keduanya butuh root,
# aksinya lewat helper ini — PHP tidak pernah memegang akses root.
#
# Prinsip: JANGAN pernah menghapus file .ini bawaan distro. Extension yang
# dimatikan file .ininya dipindahkan (bukan dihapus) lalu dicatat di state file,
# sehingga bisa dikembalikan persis seperti semula.
set -euo pipefail

STATE_DIR=/var/lib/fpanel/php-ext
PAT_VER='^[0-9]+\.[0-9]+$'
PAT_EXT='^[a-z0-9_]+$'

die() { echo "ERR: $*" >&2; exit 2; }

need_ver() {
  [ "${1:-}" != "" ] || die "versi PHP wajib diisi"
  [[ "$1" =~ $PAT_VER ]] || die "versi PHP tidak valid: $1"
}

need_ext() {
  [ "${1:-}" != "" ] || die "nama extension wajib diisi"
  [[ "$1" =~ $PAT_EXT ]] || die "nama extension tidak valid: $1"
}

conf_dir() { echo "/etc/php/$1/fpm/conf.d"; }

# extension_dir untuk versi ini. ID API berubah antar versi (20210902 untuk
# 8.1, 20230831 untuk 8.3, 20240924 untuk 8.4), jadi tidak boleh ditebak dari
# nomor versinya. php-config yang jadi sumber kebenaran.
ext_dir() {
  local ver="$1" dir=""
  # Sumber 1: php-config (dari paket phpX.Y-dev, sering tidak terpasang).
  if [ -x "/usr/bin/php-config$ver" ]; then
    dir="$(/usr/bin/php-config$ver --extension-dir 2>/dev/null || true)"
  fi
  # Sumber 2: binary PHP itu sendiri. Versi sudah divalidasi regex di atas,
  # jadi nama file-nya aman dipanggil.
  if [ -z "$dir" ] && [ -x "/usr/bin/php$ver" ]; then
    dir="$(/usr/bin/php$ver -r 'echo ini_get("extension_dir");' 2>/dev/null || true)"
  fi
  if [ -z "$dir" ] || [ ! -d "$dir" ]; then
    die "tidak bisa menentukan extension_dir untuk PHP $ver"
  fi
  echo "${dir%/}"
}

# true kalau ada .ini di conf.d yang mengaktifkan extension ini.
enabled_by() {
  local ver="$1" ext="$2" d f
  d="$(conf_dir "$ver")"
  for f in "$d"/*.ini; do
    [ -f "$f" ] || continue
    if grep -Eq "^[[:space:]]*(zend_)?extension[[:space:]]*=[[:space:]]*['\"]?${ext}\.so" "$f"; then
      echo "$f"; return 0
    fi
  done
  return 1
}

list() {
  need_ver "$1"
  local ver="$1" dir ext st
  dir="$(ext_dir "$ver")"
  for so in "$dir"/*.so; do
    [ -f "$so" ] || continue
    ext="$(basename "$so" .so)"
    if enabled_by "$ver" "$ext" >/dev/null; then st="aktif"; else st="nonaktif"; fi
    printf '%s\t%s\n' "$ext" "$st"
  done
}

# Kembalikan file .ini distro yang sebelumnya dipindah untuk satu extension.
# Dipanggil dari enable(): kalau tidak, extension akan aktif DUA kali
# (dari file distro yang dipulihkan + dari 50-fpanel-<ext>.ini) dan PHP
# memunculkan warning "Module already loaded".
restore_one() {
  local ver="$1" ext="$2"
  [ -f "$STATE_DIR/off.list" ] || return 0
  local tmp="$STATE_DIR/off.list.one" ; : > "$tmp"
  local found=0
  local v e path
  while IFS=$'\t' read -r v e path; do
    [ -n "${v:-}" ] || continue
    if [ "$v" = "$ver" ] && [ "$e" = "$ext" ] && [ -f "$path" ]; then
      mv "$path" "${path%.fpanel-off}"
      found=1
    else
      [ "$v" = "$ver" ] && [ "$e" = "$ext" ] && rm -f "$path"
      printf '%s\t%s\t%s\n' "$v" "$e" "$path" >> "$tmp"
    fi
  done < "$STATE_DIR/off.list"
  mv "$tmp" "$STATE_DIR/off.list"
  [ "$found" = "1" ]
}

enable() {
  need_ver "$1"; need_ext "$2"
  local ver="$1" ext="$2" dir d
  dir="$(ext_dir "$ver")"
  [ -f "$dir/$ext.so" ] || die "extension '$ext' tidak terpasang untuk PHP $ver"
  d="$(conf_dir "$ver")"

  mkdir -p "$STATE_DIR"
  # Kembalikan file distro yang mungkin masih tersimpan dari disable sebelumnya.
  local restored=0
  restore_one "$ver" "$ext" && restored=1
  # Kalau file distro sudah kembali, file kita tidak perlu ada lagi.
  if [ "$restored" = "1" ] && enabled_by "$ver" "$ext" >/dev/null; then
    rm -f "$d/50-fpanel-$ext.ini"
    echo "OK $ext dipulihkan ke file bawaan distro untuk PHP $ver"
    return 0
  fi
  if enabled_by "$ver" "$ext" >/dev/null; then
    echo "OK $ext sudah aktif untuk PHP $ver"; return 0
  fi
  printf '; FPanel: extension %s untuk PHP %s\n; priority=50\nextension=%s.so\n' \
    "$ext" "$ver" "$ext" > "$d/50-fpanel-$ext.ini"
  chown root:root "$d/50-fpanel-$ext.ini"; chmod 0644 "$d/50-fpanel-$ext.ini"
  echo "OK $ext diaktifkan untuk PHP $ver (restart pool agar berlaku)"
}

disable() {
  need_ver "$1"; need_ext "$2"
  local ver="$1" ext="$2" d f base
  d="$(conf_dir "$ver")"
  f="$(enabled_by "$ver" "$ext" || true)"
  if [ -z "$f" ]; then
    echo "OK $ext memang sudah nonaktif untuk PHP $ver"; return 0
  fi

  mkdir -p "$STATE_DIR"
  # File milik FPanel: hapus saja.
  case "$(basename "$f")" in
    50-fpanel-*)
      rm -f "$f"
      echo "OK $ext dimatikan untuk PHP $ver"
      return 0
      ;;
  esac
  # File bawaan distro: PINDAH, jangan dihapus, dan catat supaya bisa balik.
  base="$f.fpanel-off"
  mv "$f" "$base"
  printf '%s\t%s\t%s\n' "$ver" "$ext" "$base" >> "$STATE_DIR/off.list"
  echo "OK $ext dimatikan untuk PHP $ver (file distro disimpan, bisa dikembalikan)"
}

restore() {
  need_ver "$1"
  local ver="$1" line v e path
  [ -f "$STATE_DIR/off.list" ] || { echo "OK tidak ada yang perlu dipulihkan"; return 0; }
  local tmp="$STATE_DIR/off.list.new" ; : > "$tmp"
  while IFS=$'\t' read -r v e path; do
    [ -n "${v:-}" ] || continue
    if [ "$v" = "$ver" ] && [ -f "$path" ]; then
      mv "$path" "${path%.fpanel-off}"
      echo "OK $e dipulihkan untuk PHP $ver"
    elif [ "$v" = "$ver" ]; then
      echo "GAGAL: file untuk $e tidak ditemukan: $path" >&2
    else
      printf '%s\t%s\t%s\n' "$v" "$e" "$path" >> "$tmp"
    fi
  done < "$STATE_DIR/off.list"
  mv "$tmp" "$STATE_DIR/off.list"
}

extdir() { need_ver "$1"; ext_dir "$1"; }

# Muat ulang pool secara graceful (SIGUSR2 lewat systemctl reload).
#
# Dipakai setelah override php.ini per-domain dihapus: pool FPM menahan nilai
# PHP_VALUE dari request sebelumnya, jadi nilainya baru hilang setelah pool
# dimuat ulang. Berbeda dengan restart, reload TIDAK menutup socket listener,
# jadi tidak ada jendela 502 untuk site yang sedang dilayani.
reload_pool() {
  ver="${1:-}"
  [[ "$ver" =~ ^[0-9]+\.[0-9]+$ ]] || { echo "ERR: versi tidak valid" >&2; exit 2; }
  if systemctl reload "php${ver}-fpm" 2>/dev/null; then
    echo "OK pool php${ver}-fpm dimuat ulang"
  else
    echo "ERR: reload pool php${ver}-fpm gagal" >&2
    exit 1
  fi
}

restart() {
  need_ver "$1"
  local ver="$1"
  [ -d "/etc/php/$ver/fpm" ] || die "PHP $ver tidak terpasang"

  # PENTING: restart harus DILETAK dari proses pemanggil dan diberi jeda.
  #
  # Permintaan ini datang dari PHP-FPM. Kalau pool yang sama direstart secara
  # sinkron, master php-fpm menunggu worker menyelesaikan request, sementara
  # worker itu sendiri menunggu `systemctl restart` selesai -> deadlock.
  # Akibatnya worker dibunuh dan nginx mengembalikan 502 ke user.
  #
  # Solusinya: lepaskan (setsid) + jeda 1 detik supaya response yang sedang
  # dibangun sempat keluar dulu.
  setsid bash -c "sleep 1; systemctl restart 'php${ver}-fpm'" >/dev/null 2>&1 </dev/null &
  echo "OK pool php${ver}-fpm dijadwalkan restart (1 detik)"
}

cmd="${1:-}"; shift || true
case "$cmd" in
  list)     list "${1:-}" ;;
  enable)   enable "${1:-}" "${2:-}" ;;
  disable)  disable "${1:-}" "${2:-}" ;;
  restore)  restore "${1:-}" ;;
  extdir)   extdir "${1:-}" ;;
  restart)  restart "${1:-}" ;;
  reload)   reload_pool "${1:-}" ;;
  # Satu panggilan untuk semua versi, supaya UI bisa menampilkan matriks
  # "extension ini tersedia di versi mana saja" tanpa memanggil helper 4x.
  matrix)
    # Sengaja tanpa `local`: cabang case ini bukan fungsi, dan `local` di
    # luar fungsi akan keluar dengan error "can only be used in a function".
    for v in /etc/php/*/fpm; do
      [ -d "$v" ] || continue
      ver="$(basename "$(dirname "$v")")"
      [[ "$ver" =~ ^[0-9]+\.[0-9]+$ ]] || continue
      dir="$(ext_dir "$ver")" || continue
      for so in "$dir"/*.so; do
        [ -f "$so" ] || continue
        ext="$(basename "$so" .so)"
        if enabled_by "$ver" "$ext" >/dev/null; then st="aktif"; else st="nonaktif"; fi
        printf '%s\t%s\t%s\n' "$ver" "$ext" "$st"
      done
    done
    ;;

  ping)     echo OK ;;
  *)
    echo "ERR: subcommand tidak dikenal: '$cmd'" >&2
    echo "ERR: yang valid: list|matrix|enable|disable|restore|extdir|restart|reload|ping" >&2
    exit 2
    ;;
esac