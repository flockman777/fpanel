[Unit]
Description=FPanel app: nodeapi (node)
After=network.target
# StartLimit MUST be written in [Unit], not [Service]. In the wrong section,
# systemd refuses to load the unit on daemon-reload, so an app that was
# running dies along with it without a clear error in the panel log.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/admin/app.example.tld/public/app
Environment=PORT=30000
Environment=NODE_ENV=production
Environment=HOME=/var/www/admin
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/bin/node /var/www/admin/app.example.tld/public/app/server.js
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=fpanel-app-nodeapi

[Install]
WantedBy=multi-user.target
