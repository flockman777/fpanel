# =============================================================================
#  FPanel — contoh variabel lingkungan (OPSIONAL)
# =============================================================================
#  Semua nilai di bawah punya default di config/fpanel.php. Isi hanya yang
#  perlu di-override. JANGAN commit berkas ini dengan nilai asli — salin ke
#  lokasi yang aman dan batasi izinnya.
#
#  Cara memasang untuk php-fpm, tambahkan lewat override pool, misalnya
#  /etc/php/8.3/fpm/pool.d/zz-fpanel.conf:
#
#      [www]
#      env[FPANEL_BASE_URL] = https://panel.contoh.tld
#      env[FPANEL_CF_API_TOKEN] = xxxxx
#
#  lalu: systemctl restart php8.3-fpm
# =============================================================================

# --- Aplikasi ---------------------------------------------------------------
# URL absolut panel (dipakai untuk link & redirect).
FPANEL_BASE_URL=https://panel.contoh.tld
# 1 = tampilkan error (hanya untuk pengembangan).
FPANEL_APP_DEBUG=0

# --- Cloudflare (SSL DNS-01) -----------------------------------------------
# Dibutuhkan bila port 80 tertutup sehingga HTTP-01 tidak bisa dipakai.
FPANEL_CF_API_TOKEN=
FPANEL_CF_ZONE_ID=

# --- SMTP relay (notifikasi) ------------------------------------------------
# Port 25 inbound biasanya diblokir penyedia; pakai relay pihak ketiga.
FPANEL_MAIL_RELAY_HOST=
FPANEL_MAIL_RELAY_PORT=587
FPANEL_MAIL_RELAY_USER=
FPANEL_MAIL_RELAY_PASS=
FPANEL_MAIL_FROM=
