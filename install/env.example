# =============================================================================
#  FPanel — environment variable example (OPTIONAL)
# =============================================================================
#  Every value below has a default in config/fpanel.php. Set only the ones you
#  need to override. NEVER commit this file with real values — copy it to a
#  safe location and restrict its permissions.
#
#  To set them for php-fpm, add a pool override such as
#  /etc/php/8.3/fpm/pool.d/zz-fpanel.conf:
#
#      [www]
#      env[FPANEL_BASE_URL] = https://panel.example.tld
#      env[FPANEL_CF_API_TOKEN] = xxxxx
#
#  then: systemctl restart php8.3-fpm
# =============================================================================

# --- Application ------------------------------------------------------------
# Absolute panel URL (used for links & redirects).
FPANEL_BASE_URL=https://panel.example.tld
# 1 = show errors (development only).
FPANEL_APP_DEBUG=0

# --- Cloudflare (DNS-01 SSL) ------------------------------------------------
# Needed when port 80 is closed so HTTP-01 cannot be used.
FPANEL_CF_API_TOKEN=
FPANEL_CF_ZONE_ID=

# --- SMTP relay (notifications) ---------------------------------------------
# Inbound port 25 is usually blocked by hosting providers; use a third-party
# relay instead.
FPANEL_MAIL_RELAY_HOST=
FPANEL_MAIL_RELAY_PORT=587
FPANEL_MAIL_RELAY_USER=
FPANEL_MAIL_RELAY_PASS=
FPANEL_MAIL_FROM=
