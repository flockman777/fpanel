# FPanel - control panel on the official domain
# The location structure mirrors /etc/nginx/sites-available/fpanel (port 8090)
# so the app behaves identically on 8090 and 443.
server {
    listen 80;
    listen [::]:80;
    server_name panel.example.tld www.panel.example.tld;

    root /var/www/acme/challenges;
    index index.html;

    # ACME challenges are served as-is before the redirect, otherwise
    # certbot renewal would be redirected to HTTPS and fail.
    location ^~ /.well-known/acme-challenge/ {
        alias /var/www/acme/challenges/.well-known/acme-challenge/;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name panel.example.tld www.panel.example.tld;

    ssl_certificate     /etc/letsencrypt/live/panel.example.tld/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.example.tld/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_trusted_certificate /etc/letsencrypt/live/panel.example.tld/fullchain.pem;

    # Security headers are NOT defined here. The application already sends them
    # itself, and two add_header directives for the same key produce
    # duplicate headers (e.g. two X-Frame-Options with different values).
    # HSTS stays here because it is only relevant at the TLS layer.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    root /srv/fpanel/app/public;
    index index.php;

    client_max_body_size 512M;
    server_tokens off;

    access_log /srv/fpanel/var/log/nginx-access.log;
    error_log  /srv/fpanel/var/log/nginx-error.log warn;

    location = /favicon.svg { alias /srv/fpanel/app/public/assets/img/favicon.svg; }
    location = /favicon.ico { alias /srv/fpanel/app/public/assets/img/favicon.ico; }

    # ---- reject internal files (must come before location .php$) ----------
    location ~ /\.                                          { deny all; }
    location ~* ^/(var|config|bin|tests|install|node_modules|app/src)/ { deny all; }

    location / { try_files $uri $uri/ /index.php?$query_string; }

        
    
    
    
    
        # BEGIN FPANEL-PMA
    # ---- per-database phpMyAdmin (single-use token) -------------------
    # Flow: /pma/<token>/... -> rewrite -> /fpma/... (internal) -> front
    # controller fpma-index.php, which validates the token and then calls
    # phpMyAdmin. Token validation deliberately lives in PHP, not in nginx:
    # with "if (!-f ...)" in nginx the behavior is hard to pin down,
    # while in PHP the result is explicit: 404 or phpMyAdmin.
    #
    # The regex MUST be quoted: without quotes nginx treats "}"
    # as the end of the block; even escaped ("\{32\}") PCRE treats it
    # as literal curly braces, not a repetition.
    location ~ "^/pma/(?<fptok>[a-f0-9]{32})(/.*)?$" {
        rewrite "^/pma/[a-f0-9]{32}(/.*)?$" /fpma$1 last;
    }
    # Without a token: there is nothing here.
    location = /pma { return 404; }
    location /pma/ { return 404; }

    # Internal target: cannot be accessed directly, only through the rewrite above.
    location ~ ^/fpma/.+\.php$ {
        internal;
        include fastcgi_params;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME /usr/share/phpmyadmin/fpma-index.php;
        fastcgi_param SCRIPT_NAME     /index.php;
        fastcgi_param DOCUMENT_ROOT   /usr/share/phpmyadmin;
    }
    location ~ ^/fpma(?<fpapath>/.*)?$ {
        internal;
        root /usr/share/phpmyadmin;
        try_files /$fpapath /$fpapath/index.php /fpma/index.php;
    }
    # END FPANEL-PMA

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/run/php/php8.3-fpm.sock;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
    }
}
