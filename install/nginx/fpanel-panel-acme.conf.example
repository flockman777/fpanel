# FPanel - panel domain vhost, first stage (port 80 only)
#
# Installed by the installer BEFORE a certificate exists, because a 443 vhost
# pointing at a missing certificate makes `nginx -t` fail and takes all of nginx down.
# After certbot succeeds, this file is replaced by the full 80 + 443 version
# (fpanel-panel.conf.example).
server {
    listen 80;
    listen [::]:80;
    server_name panel.example.tld www.panel.example.tld;

    root /var/www/acme/challenges;
    index index.html;

    # ACME challenges are served as-is before the redirect, otherwise
    # certbot renewal would be redirected to HTTPS and fail.
    location ^~ /.well-known/acme-challenge/ {
        alias /var/www/acme/challenges/.well-known/acme-challenge/;
        default_type "text/plain";
        try_files $uri =404;
    }

    location / { return 301 https://$host$request_uri; }
}
