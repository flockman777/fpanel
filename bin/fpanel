#!/usr/bin/env php
<?php
declare(strict_types=1);
require dirname(__DIR__) . '/app/bootstrap.php';

use Fpanel\Database\Connection;
use Fpanel\Auth\PasswordHasher;
use Fpanel\Service\Validator;
use Fpanel\Service\Backup;
use Fpanel\Service\PhpMyAdmin;
use Fpanel\Service\Housekeeping;
use Fpanel\Auth\LoginLink;
use Fpanel\Auth\RememberDevice;
use Fpanel\Service\Offsite;
use Fpanel\Service\SecretBox;
use Fpanel\Service\Totp;
use Fpanel\Service\Usage;
use Fpanel\Service\Wp;

$argvIn = $argv; array_shift($argvIn);
$cmd = array_shift($argvIn) ?? 'help';

function out(string $m): void { fwrite(STDOUT, $m . "\n"); }

switch ($cmd) {
    case 'user:create':
        $username = $argvIn[0] ?? '';
        $password = $argvIn[1] ?? '';
        $email    = $argvIn[2] ?? '';
        $role     = $argvIn[3] ?? 'user';
        foreach ([['username', $username, Validator::username($username)],
                  ['email', $email, Validator::email($email)],
                  ['password', $password, Validator::password($password)]] as [$f, $v, $err]) {
            if ($err !== null) { out("Error ($f): $err"); exit(1); }
        }
        if (!in_array($role, ['admin', 'user'], true)) { out("Error: role must be admin|user"); exit(1); }
        $id = Connection::insert('users', [
            'username' => strtolower($username),
            'email' => $email,
            'password_hash' => PasswordHasher::hash($password),
            'role' => $role,
            'status' => 'active',
        ]);
        out("OK user #$id created: $username ($role)");
        break;

    // Delete a user. Refuses to delete the last admin so we do not lock
    // ourselves out of the panel.
    case 'user:delete':
        $username = $argvIn[0] ?? '';
        if ($username === '') { out("Error: usage: user:delete <username>"); exit(1); }
        $row = Connection::one('SELECT id, role FROM users WHERE username = :u',
            ['u' => strtolower($username)]);
        if ($row === null) {
            out("Error: user '$username' does not exist");
            exit(1);
        }
        $admins = (int)Connection::value(
            "SELECT COUNT(*) FROM users WHERE role = 'admin' AND status = 'active'");
        if ($row['role'] === 'admin' && $admins <= 1) {
            out('Error: this is the last active admin and cannot be deleted');
            exit(1);
        }
        // The user's domains must move first; a silent cascade would
        // leave sites orphaned without a docroot.
        $domains = Connection::all('SELECT name FROM domains WHERE user_id = :u',
            ['u' => (int)$row['id']]);
        if ($domains !== []) {
            $names = array_map(static fn (array $d): string => (string)$d['name'], $domains);
            out('Error: user still owns domains: ' . implode(', ', $names));
            exit(1);
        }
        Connection::run('DELETE FROM sessions WHERE user_id = :i', ['i' => (int)$row['id']]);
        Connection::run('DELETE FROM login_attempts WHERE username = :u',
            ['u' => strtolower($username)]);
        // Tables without an FK ON DELETE CASCADE must be cleaned up manually.
        // Otherwise their rows are orphaned and can still be used by a user with the same id.
        foreach (['totp_recovery'] as $t) {
            Connection::run("DELETE FROM $t WHERE user_id = :i", ['i' => (int)$row['id']]);
        }
        Connection::run('DELETE FROM users WHERE id = :i', ['i' => (int)$row['id']]);
        out("OK user $username deleted");
        break;

    // Password rotation from the CLI. There used to be no official way besides
    // editing the users table by hand - prone to a wrong hash / a forgotten salt.
    case 'user:pass':
        $username = $argvIn[0] ?? '';
        $password = $argvIn[1] ?? '';
        if ($username === '' || $password === '') {
            out("Error: usage: user:pass <username> <password>");
            exit(1);
        }
        if (($err = Validator::password($password)) !== null) {
            out("Error (password): $err");
            exit(1);
        }
        $id = Connection::value('SELECT id FROM users WHERE username = :u',
            ['u' => strtolower($username)]);
        if ($id === null) {
            out("Error: user '$username' does not exist");
            exit(1);
        }
        Connection::run('UPDATE users SET password_hash = :h, updated_at = datetime(\'now\') WHERE id = :id',
            ['h' => PasswordHasher::hash($password), 'id' => (int)$id]);
        // Old sessions must die, otherwise the old password still works in
        // browsers that are already logged in.
        Connection::run('DELETE FROM sessions WHERE user_id = :id', ['id' => (int)$id]);
        Connection::run('DELETE FROM login_attempts WHERE username = :u',
            ['u' => strtolower($username)]);
        out("OK password for $username changed; old sessions revoked");
        break;

    // config/schema.sql only applies to tables that do NOT exist yet. A running
    // installation does not get new columns from CREATE TABLE IF NOT EXISTS,
    // so the SSL columns need an explicit ALTER TABLE here. Idempotent.
    case 'db:migrate-ssl':
        $pdo = Connection::pdo();
        $have = [];
        foreach ($pdo->query('PRAGMA table_info(domains)') as $col) { $have[$col['name']] = true; }
        $add = [
            'ssl_status'    => "TEXT NOT NULL DEFAULT 'none'",
            'ssl_issued_at' => 'TEXT',
            'ssl_error'     => 'TEXT',
        ];
        $added = 0;
        foreach ($add as $col => $def) {
            if (isset($have[$col])) { continue; }
            $pdo->exec("ALTER TABLE domains ADD COLUMN {$col} {$def}");
            out("  + {$col}");
            $added++;
        }
        out($added === 0 ? '  all SSL columns already exist (idempotent)' : "  {$added} column(s) added");
        break;

    // The Python app quota is separate from Node's. If both shared one quota,
    // a single Node app would exhaust the Python quota.
    case 'db:migrate-pkg':
        $cols  = Connection::all("PRAGMA table_info(packages)");
        $have  = array_column($cols, 'name');
        $added = 0;
        if (!in_array('max_python_apps', $have, true)) {
            Connection::run('ALTER TABLE packages ADD COLUMN max_python_apps INTEGER NOT NULL DEFAULT 1');
            $added++;
            out('+ packages.max_python_apps');
        }
        out($added === 0 ? 'all columns already exist' : "$added column(s) added");
        break;

    // Table for runtime apps (Node.js / Python). schema.sql only does CREATE
    // TABLE IF NOT EXISTS, so a new table only needs creating once here.
    case 'db:migrate-apps':
        Connection::pdo()->exec(
            "CREATE TABLE IF NOT EXISTS runtime_apps ("
            . "id INTEGER PRIMARY KEY AUTOINCREMENT,"
            . "user_id INTEGER NOT NULL,"
            . "username TEXT NOT NULL,"
            . "domain_id INTEGER,"
            . "name TEXT NOT NULL,"
            . "kind TEXT NOT NULL,"
            . "root TEXT NOT NULL,"
            . "entry TEXT NOT NULL,"
            . "node_version TEXT,"
            . "port INTEGER NOT NULL,"
            . "status TEXT NOT NULL DEFAULT 'stopped',"
            . "created_at TEXT NOT NULL DEFAULT (datetime('now')))"
        );
        Connection::pdo()->exec(
            'CREATE UNIQUE INDEX IF NOT EXISTS idx_runtime_apps_user_name'
            . ' ON runtime_apps (user_id, name)'
        );
        Connection::pdo()->exec(
            'CREATE UNIQUE INDEX IF NOT EXISTS idx_runtime_apps_port ON runtime_apps (port)'
        );
        out('OK tabel runtime_apps siap');
        break;

    // Adds the php_ini column to the domains table. schema.sql only CREATE TABLE
    # IF NOT EXISTS, so existing installations do not get the new column.
    case 'db:migrate-ini':
        $cols = Connection::all("PRAGMA table_info(domains)");
        $have = [];
        foreach ($cols as $c) {
            $have[] = (string)$c['name'];
        }
        $added = 0;
        if (!in_array('php_ini', $have, true)) {
            Connection::run('ALTER TABLE domains ADD COLUMN php_ini TEXT');
            $added++;
            out('+ domains.php_ini');
        }
        out($added === 0 ? 'all columns already exist' : "$added column(s) added");
        break;

    case 'db:migrate':
        Connection::pdo()->exec((string)file_get_contents(FPANEL_ROOT . '/config/schema.sql'));
        out("OK schema applied");
        break;

    case 'db:reset':
        Connection::reset();
        Connection::pdo()->exec((string)file_get_contents(FPANEL_ROOT . '/config/schema.sql'));
        out("OK database reset");
        break;

    case 'login:reset':
        Connection::run("DELETE FROM login_attempts");
        out("OK login_attempts cleared");
        break;

    case 'login:count':
        out((string)(int)Connection::value("SELECT COUNT(*) FROM login_attempts WHERE success = 0"));
        break;

    case 'audit:count':
        $a = $argvIn[0] ?? null; $r = $argvIn[1] ?? null;
        if ($a === null) { out((string)(int)Connection::value('SELECT COUNT(*) FROM audit_log')); break; }
        $w = $r === null ? '' : ' AND result = :r';
        $q = "SELECT COUNT(*) FROM audit_log WHERE action = :a" . $w;
        $pp = $r === null ? ['a'=>$a] : ['a'=>$a,'r'=>$r];
        out((string)(int)Connection::value($q, $pp));
        break;

    case 'audit:leak':
        $n = (string)$argvIn[0] ?? '';
        out((string)(int)Connection::value('SELECT COUNT(*) FROM audit_log WHERE meta LIKE :n', ['n' => '%' . $n . '%']));
        break;

    case 'session:count':
        $h = hash('sha256', (string)($argvIn[0] ?? ''));
        out((string)(int)Connection::value('SELECT COUNT(*) FROM sessions WHERE token_hash = :h', ['h' => $h]));
        break;

    case 'user:hashlen':
        out((string)strlen((string)Connection::value('SELECT password_hash FROM users WHERE username = :u', ['u'=>$argvIn[0] ?? ''])));
        break;

    case 'user:hashis':
        $h = (string)Connection::value('SELECT password_hash FROM users WHERE username = :u', ['u'=>$argvIn[0] ?? '']);
        out(str_starts_with($h, '$argon2') ? 'argon2' : (str_starts_with($h, '$2y') ? 'bcrypt' : 'other'));
        break;

    case 'user:list':
        foreach (Connection::all('SELECT id,username,email,role,status,last_login_at FROM users ORDER BY id') as $r) {
            out(sprintf('#%-3d %-14s %-26s %-6s %-9s last=%s',
                $r['id'], $r['username'], $r['email'], $r['role'], $r['status'], $r['last_login_at'] ?? '-'));
        }
        break;

    case 'domain:id':
        $v = Connection::value('SELECT id FROM domains WHERE name = :n', ['n' => $argvIn[0] ?? '']);
        out($v === null ? '' : (string)$v);
        break;

    case 'domain:count':
        $u = $argvIn[0] ?? null;
        $q = 'SELECT COUNT(*) FROM domains' . ($u === null ? '' : ' WHERE user_id = (SELECT id FROM users WHERE username = :u)');
        $pp = $u === null ? [] : ['u' => $u];
        out((string)(int)Connection::value($q, $pp));
        break;

    case 'test:quota-park':
        // The admin package quota is raised temporarily so the suite has
        // room to create many test domains. The old values are stored first,
        // so test:quota-restore restores the production policy exactly as it was.
        //
        // Used only by tests/run.sh; kept out of the normal CLI so it is
        // not mistaken for a production feature.
        $pk = Connection::one(
            'SELECT p.id, p.max_domains, p.max_subdomains, p.max_databases,
                    p.max_db_users, p.max_node_apps, p.max_python_apps
               FROM users u JOIN packages p ON p.id = u.package_id
              WHERE u.username = :u',
            ['u' => 'admin']
        );
        if ($pk === null) {
            out('Error: admin plan not found');
            exit(1);
        }
        $save = '/var/lib/fpanel/test-quota.json';
        @mkdir(dirname($save), 0750, true);
        if (!is_file($save)) {
            file_put_contents($save, json_encode($pk, JSON_PRETTY_PRINT));
        }
        // Without an argument: quota becomes (used domains + 5). Using a fixed
        // number that is far larger would make the section testing quota limits
        // create dozens of test domains too and leave residue behind.
        $n = (int)($argvIn[0] ?? 0);
        if ($n < 1) {
            $used = (int)Connection::value('SELECT COUNT(*) FROM domains WHERE user_id = :u',
                ['u' => (int)Connection::value('SELECT id FROM users WHERE username = :n', ['n' => 'admin'])]);
            $n = $used + 5;
        }
        Connection::update('packages', [
            'max_domains'    => $n,
            'max_subdomains' => max($n, 20),
            'max_databases'  => max($n, 10),
            'max_db_users'   => max($n, 10),
            'max_node_apps'  => 10,
            'max_python_apps'=> 10,
        ], 'id = :i', ['i' => (int)$pk['id']]);
        out('OK temporary quota raised to ' . $n);
        break;

    case 'test:quota-restore':
        $save = '/var/lib/fpanel/test-quota.json';
        if (!is_file($save)) {
            out('OK no temporary quota to restore');
            break;
        }
        $pk = json_decode((string)file_get_contents($save), true);
        if (!is_array($pk)) {
            out('Error: quota file is corrupt');
            exit(1);
        }
        Connection::update('packages', [
            'max_domains'     => (int)$pk['max_domains'],
            'max_subdomains'  => (int)$pk['max_subdomains'],
            'max_databases'   => (int)$pk['max_databases'],
            'max_db_users'    => (int)($pk['max_db_users'] ?? 3),
            'max_node_apps'   => (int)$pk['max_node_apps'],
            'max_python_apps' => (int)$pk['max_python_apps'],
        ], 'id = :i', ['i' => (int)$pk['id']]);
        @unlink($save);
        out('OK plan quota restored: ' . (int)$pk['max_domains'] . ' domain');
        break;

    case 'test:quota-park [n] | test:quota-restore | package:domain-quota':
        // Domain quota from the package the user holds. Used by the test suite
        // so tests do not have to guess the package numbers in code.
        $u  = (string)($argvIn[0] ?? '');
        $pk = Connection::one(
            'SELECT p.max_domains FROM users u JOIN packages p ON p.id = u.package_id WHERE u.username = :u',
            ['u' => $u]
        );
        out((string)(int)($pk['max_domains'] ?? 5));
        break;

    case 'package:domain-quota':
        // Domain quota from the package the user holds. Used by the test suite
        // so tests do not have to guess the package numbers in code.
        $u  = (string)($argvIn[0] ?? '');
        $pk = Connection::one(
            'SELECT p.max_domains FROM users u JOIN packages p ON p.id = u.package_id WHERE u.username = :u',
            ['u' => $u]
        );
        out($pk === null ? '5' : (string)(int)$pk['max_domains']);
        break;

    case 'domain:exists':
        $n = (string)($argvIn[0] ?? '');
        out((string)(int)Connection::value('SELECT COUNT(*) FROM domains WHERE name LIKE :n', ['n' => '%' . $n . '%']));
        break;

    // Prepares the per-domain scan directory for every installed PHP version.
    // MUST run as root: /etc/php/<v>/fpm/conf.d is owned by root,
    // while the app runs as www-data and cannot create it.
    // Without this, creating a domain with PHP 8.1/8.2/8.4 will fail.
    case 'php:prep':
        $vers = glob('/etc/php/*/fpm', GLOB_ONLYDIR) ?: [];
        $made = 0;
        foreach ($vers as $dir) {
            if (!preg_match('#/etc/php/([0-9]+\.[0-9]+)/#', $dir, $m)) {
                continue;
            }
            $target = $dir . '/conf.d/domains';
            if (is_dir($target)) {
                continue;
            }
            // Created as www-data so the app can make per-domain subdirectories.
            if (@mkdir($target, 0755, true) && @chown($target, 'www-data')) {
                $made++;
                out("+ {$m[1]} $target");
            } else {
                out("Error: $target (run as root)");
                break;
            }
        }
        out($made === 0 ? 'all directories already exist' : "$made directories created");
        break;

    // Backup: create/list/verify/delete/retention. Restore is DELIBERATELY
    // absent from the non-interactive CLI -- restore overwrites a live database, so
    // it has to be run manually through the helper so the operator can watch the log.
    case 'backup:create':
        $keep = (string)($argvIn[0] ?? '7');
        $r    = Backup::create((int)$keep);
        out($r['ok'] ? (string)$r['message'] : ('Error: ' . (string)$r['error']));
        break;

    case 'backup:list':
        $l = Backup::listing();
        if (!$l['ok']) {
            out('Error: ' . (string)$l['error']);
            break;
        }
        if ($l['items'] === []) {
            out('(no backups yet)');
            break;
        }
        foreach ($l['items'] as $b) {
            out($b['name'] . "\t" . $b['created_utc'] . "\t" . $b['size_human']);
        }
        break;

    case 'backup:verify':
        $name = (string)($argvIn[0] ?? '');
        $r    = Backup::verify($name);
        out(trim((string)$r['report']) !== '' ? (string)$r['report'] : (string)$r['error']);
        if (!$r['ok']) { exit(1); }
        break;

    case 'backup:delete':
        $r = Backup::delete((string)($argvIn[0] ?? ''));
        out($r['ok'] ? (string)$r['message'] : ('Error: ' . (string)$r['error']));
        break;

    case 'backup:prune':
        $r = Backup::prune((int)($argvIn[0] ?? '7'));
        out($r['ok'] ? (string)$r['message'] : ('Error: ' . (string)$r['error']));
        break;

    // Cleans up phpMyAdmin tokens that passed their TTL. Called by cron
    // every 10 minutes; also called automatically whenever a new token is created.
    case 'db:migrate-totp':
        // The kind column tells a full login session apart from an intermediate
        // session (waiting for the 2FA code). Without it, 2FA sessions could count as logins.
        $cols = [];
        foreach (Connection::pdo()->query("PRAGMA table_info(sessions)") as $c) {
            $cols[] = (string)$c['name'];
        }
        if (!in_array('kind', $cols, true)) {
            Connection::pdo()->exec(
                "ALTER TABLE sessions ADD COLUMN kind TEXT NOT NULL DEFAULT 'auth'"
            );
        }
        // The table is rebuilt when its old version has no foreign key.
        // Without an FK, user:delete leaves orphaned recovery codes: their values
        // can still be matched once a new user appears with the same id
        // (SQLite allows id reuse).
        $shape = (string)Connection::value(
            "SELECT COALESCE(sql, '') FROM sqlite_master WHERE type = 'table' AND name = 'totp_recovery'"
        );
        $hasFk = $shape !== '' && str_contains($shape, 'REFERENCES');
        if ($shape !== '' && !$hasFk) {
            Connection::pdo()->exec('ALTER TABLE totp_recovery RENAME TO totp_recovery_legacy');
        }
        Connection::pdo()->exec(
            'CREATE TABLE IF NOT EXISTS totp_recovery ('
            . 'id INTEGER PRIMARY KEY AUTOINCREMENT,'
            . 'user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,'
            . 'code_hash TEXT NOT NULL,'
            . 'used_at TEXT,'
            . 'created_at TEXT NOT NULL DEFAULT (datetime(\'now\')))'
        );
        if ($shape !== '' && !$hasFk) {
            // Codes belonging to users that still exist are kept, the rest are dropped.
            Connection::pdo()->exec(
                'INSERT INTO totp_recovery (user_id, code_hash, used_at, created_at) '
                . 'SELECT user_id, code_hash, used_at, created_at FROM totp_recovery_legacy '
                . 'WHERE user_id IN (SELECT id FROM users)'
            );
            Connection::pdo()->exec(
                'DELETE FROM totp_recovery WHERE user_id NOT IN (SELECT id FROM users)'
            );
            Connection::pdo()->exec('DROP TABLE totp_recovery_legacy');
        }
        Connection::pdo()->exec(
            'CREATE INDEX IF NOT EXISTS idx_totp_recovery_user ON totp_recovery (user_id)'
        );
        out('OK 2FA ready (sessions.kind column + totp_recovery table)');
        break;

    case 'db:migrate-usage':
        // SQL string literals (datetime('now'), '[]') are written with double
        // quotes in PHP because ' is not a valid escape in single-quoted PHP.
        Connection::pdo()->exec(
            "CREATE TABLE IF NOT EXISTS domain_usage ("
            . "domain_id INTEGER PRIMARY KEY,"
            . "measured_at TEXT NOT NULL DEFAULT (datetime('now')),"
            . "disk_bytes INTEGER NOT NULL DEFAULT 0,"
            . "bandwidth_bytes INTEGER NOT NULL DEFAULT 0,"
            . "requests INTEGER NOT NULL DEFAULT 0,"
            . "errors_4xx INTEGER NOT NULL DEFAULT 0,"
            . "errors_5xx INTEGER NOT NULL DEFAULT 0,"
            . "log_updated_at TEXT,"
            . "top_paths TEXT NOT NULL DEFAULT '[]')"
        );
        // resource_usage is read by the dashboard; one row per user.
        Connection::pdo()->exec(
            'CREATE UNIQUE INDEX IF NOT EXISTS idx_resource_usage_user ON resource_usage (user_id)'
        );
        out('OK domain_usage table ready');
        break;

    case 'db:migrate-domain-type':
        // Drop the 'node'/'python'/'binary' domain types.
        //
        // An SQLite CHECK constraint cannot be changed without rebuilding
        // the table, so the steps are: rename -> recreate -> copy -> drop old.
        // The runtime_apps table is the source of truth for runtimes, so the value
        // is not lost: apps stay attached through their domain_id.
        $pdo = Connection::pdo();
        $shape = (string)Connection::value(
            "SELECT COALESCE(sql, '') FROM sqlite_master WHERE type = 'table' AND name = 'domains'"
        );
        if ($shape === '') {
            out('Error: domains table does not exist');
            exit(1);
        }

        $needsRebuild = str_contains($shape, "'node'");
        if ($needsRebuild) {
            // Every step runs inside a transaction. SQLite DDL is transactional too,
            // so a failure midway (e.g. a CHECK constraint) rolls back
            // completely: the original table stays intact and no FK points at
            // domains_legacy_type. Without a transaction, such a failure
            // leaves six tables with broken references.
            $pdo->beginTransaction();
        }
        try {
        if ($needsRebuild) {
            $before = (int)Connection::value('SELECT COUNT(*) FROM domains');
            $pdo->exec('PRAGMA foreign_keys = OFF');
            $pdo->exec('ALTER TABLE domains RENAME TO domains_legacy_type');

            // Columns are copied one by one so an old schema without a
            // new column (e.g. app_id) does not make the CREATE FAIL.
            $newCols = [];
            foreach ($pdo->query('PRAGMA table_info(domains_legacy_type)') as $c) {
                $newCols[(string)$c['name']] = (string)$c['name'];
            }

            $pdo->exec(
                'CREATE TABLE domains ('
                . 'id INTEGER PRIMARY KEY,'
                . 'user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,'
                . 'name TEXT NOT NULL UNIQUE,'
                . 'type TEXT NOT NULL DEFAULT ' . "'php'"
                . " CHECK (type IN ('static','php')),"
                . 'is_subdomain INTEGER NOT NULL DEFAULT 0,'
                . 'parent_domain TEXT,'
                . 'docroot TEXT NOT NULL,'
                . 'php_version TEXT,'
                . 'node_version TEXT,'
                . 'runtime_port INTEGER,'
                . 'app_id TEXT,'
                . "status TEXT NOT NULL DEFAULT 'active'"
                . " CHECK (status IN ('active','suspended','error')),"
                . 'has_wellknown INTEGER NOT NULL DEFAULT 0,'
                . "ssl_status TEXT NOT NULL DEFAULT 'none'"
                . " CHECK (ssl_status IN ('none','pending','active','error','revoked')),"
                . 'ssl_issued_at TEXT,'
                . 'ssl_error TEXT,'
                . 'php_ini TEXT,'
                . "created_at TEXT NOT NULL DEFAULT (datetime('now')),"
                . "updated_at TEXT NOT NULL DEFAULT (datetime('now')))"
            );

            // The remapping must happen INSIDE the INSERT, not after it.
            // The new table has CHECK type IN ('static','php'), so copying
            // the 'node' value as-is first would be rejected by SQLite and
            // leave the domains table empty.
            $remapSql = "CASE type"
                . " WHEN 'node' THEN 'php'"
                . " WHEN 'python' THEN 'php'"
                . " WHEN 'binary' THEN 'php'"
                . ' ELSE type END';

            $cols = array_map(static fn (string $c): string => '"' . $c . '"', array_keys($newCols));
            $sel  = array_map(
                static fn (string $c): string => $c === 'type' ? $remapSql : $c,
                array_keys($newCols)
            );
            $pdo->exec(
                'INSERT INTO domains (' . implode(', ', $cols) . ')'
                . ' SELECT ' . implode(', ', $sel) . ' FROM domains_legacy_type'
            );

            $pdo->exec('DROP TABLE domains_legacy_type');
            $pdo->exec('PRAGMA foreign_keys = ON');
            $after = (int)Connection::value('SELECT COUNT(*) FROM domains');
            if ($after !== $before) {
                throw new \RuntimeException(
                    'domain count changed during migration (' . $before . ' -> ' . $after . ')'
                );
            }
        }
        } catch (\Throwable $e) {
            if ($pdo->inTransaction()) {
                $pdo->rollBack();
            }
            out('Error: ' . $e->getMessage() . ' (changes rolled back)');
            exit(1);
        }
        if ($needsRebuild) {
            $pdo->commit();
        }

        // The old indexes vanish along with the table; recreate them.
        $pdo->exec('CREATE INDEX IF NOT EXISTS ix_domains_user ON domains(user_id)');
        $pdo->exec('CREATE INDEX IF NOT EXISTS ix_domains_port ON domains(runtime_port)');

        // runtime_apps.domain_id becomes a real FK so apps get deleted
        // along with their domain (previously there was no FK at all).
        $appShape = (string)Connection::value(
            "SELECT COALESCE(sql, '') FROM sqlite_master WHERE type = 'table' AND name = 'runtime_apps'"
        );
        if ($appShape !== '' && !str_contains($appShape, 'REFERENCES')) {
            $pdo->exec('PRAGMA foreign_keys = OFF');
            $pdo->exec('ALTER TABLE runtime_apps RENAME TO runtime_apps_legacy');
            $pdo->exec(
                'CREATE TABLE runtime_apps ('
                . 'id INTEGER PRIMARY KEY AUTOINCREMENT,'
                . 'user_id INTEGER NOT NULL,'
                . 'username TEXT NOT NULL,'
                . 'domain_id INTEGER REFERENCES domains(id) ON DELETE CASCADE,'
                . 'name TEXT NOT NULL,'
                . 'kind TEXT NOT NULL,'
                . 'root TEXT NOT NULL,'
                . 'entry TEXT NOT NULL,'
                . 'node_version TEXT,'
                . 'port INTEGER NOT NULL,'
                . "status TEXT NOT NULL DEFAULT 'stopped',"
                . "created_at TEXT NOT NULL DEFAULT (datetime('now')))"
            );
            $pdo->exec(
                'INSERT INTO runtime_apps (id,user_id,username,domain_id,name,kind,root,entry,node_version,port,status,created_at)'
                . ' SELECT id,user_id,username,domain_id,name,kind,root,entry,node_version,port,status,created_at'
                . ' FROM runtime_apps_legacy'
            );
            $pdo->exec('DROP TABLE runtime_apps_legacy');
            $pdo->exec('PRAGMA foreign_keys = ON');
        }
        $pdo->exec('CREATE UNIQUE INDEX IF NOT EXISTS idx_runtime_apps_user_name ON runtime_apps (user_id, name)');
        $pdo->exec('CREATE UNIQUE INDEX IF NOT EXISTS idx_runtime_apps_port ON runtime_apps (port)');

        $left = (int)Connection::value(
            "SELECT COUNT(*) FROM domains WHERE type NOT IN ('static','php')"
        );
        $types = [];
        foreach (Connection::all('SELECT type, COUNT(*) c FROM domains GROUP BY type') as $r) {
            $types[] = (string)$r['type'] . '=' . (int)$r['c'];
        }
        out('OK domain types simplified: ' . implode(' ', $types)
            . ($left > 0 ? " ($left unknown values left)" : ''));
        break;

    case 'db:migrate-devices':
        // One-time login links and "remember this device".
        //
        // The created_at column uses DEFAULT (datetime('now')), which is indeed
        // a SQLite expression, but must NOT be written as a string literal
        // in PHP: double quotes there make PDO send '"now"' and
        // SQLite rejects it as "default value is not constant".
        $pdo = Connection::pdo();
        $pdo->exec(
            'CREATE TABLE IF NOT EXISTS login_links ('
            . 'id INTEGER PRIMARY KEY,'
            . 'user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,'
            . 'token_hash TEXT NOT NULL UNIQUE,'
            . 'ip_hint TEXT,'
            . 'used_at TEXT,'
            . 'expires_at TEXT NOT NULL,'
            . 'created_at TEXT NOT NULL DEFAULT (datetime(' . "'now'" . ')))'
        );
        $pdo->exec('CREATE INDEX IF NOT EXISTS idx_login_links_user ON login_links (user_id)');

        $pdo->exec(
            'CREATE TABLE IF NOT EXISTS remember_devices ('
            . 'id INTEGER PRIMARY KEY,'
            . 'user_id INTEGER NOT NULL REFERENCES users(id) ON DELETE CASCADE,'
            . 'token_hash TEXT NOT NULL UNIQUE,'
            . 'ip TEXT,'
            . 'user_agent TEXT,'
            . 'revoked_at TEXT,'
            . 'expires_at TEXT NOT NULL,'
            . 'last_used_at TEXT,'
            . 'created_at TEXT NOT NULL DEFAULT (datetime(' . "'now'" . ')))'
        );
        $pdo->exec('CREATE INDEX IF NOT EXISTS idx_remember_devices_user ON remember_devices (user_id)');

        // Idempotent: if the table already exists, the CREATE IF NOT EXISTS
        // statements above are skipped without error.
        out('OK devices & login links ready');
        break;

    case 'totp:encrypt-secrets':
        // Old TOTP seeds may still be plaintext in the database. This job turns
        // them into encrypted ones without touching already-encrypted values, and
        // verifies the round-trip so nothing silently fails to read.
        if (!SecretBox::available()) {
            out('Error: cannot read /etc/fpanel/app-key; seed left as plain text');
            exit(1);
        }
        $rows = Connection::all(
            "SELECT id, username, totp_secret FROM users
              WHERE totp_secret IS NOT NULL AND totp_secret <> ''"
        );
        $done = 0;
        foreach ($rows as $r) {
            $raw = (string)$r['totp_secret'];
            if (SecretBox::isEncrypted($raw)) {
                continue;
            }
            $enc = SecretBox::encrypt($raw);
            if ($enc === null || SecretBox::decrypt($enc) !== $raw) {
                out('Error: encryption failed for ' . (string)$r['username']);
                exit(1);
            }
            Connection::update('users', ['totp_secret' => $enc], 'id = :id', ['id' => (int)$r['id']]);
            $done++;
        }
        out('OK ' . (string)$done . ' secrets encrypted out of ' . (string)count($rows) . ' total');
        break;

    case 'login-link:issue':
        $u = (string)($argvIn[0] ?? '');
        if ($u === '') {
            out('Error: usage: login-link:issue <username>');
            exit(2);
        }
        $r = LoginLink::issue($u);
        if (empty($r['ok'])) {
            out('Error: ' . (string)$r['error']);
            exit(1);
        }
        out((string)$r['token']);
        break;

    case 'login-link:count':
        out((string)LoginLink::activeCount());
        break;

    case 'device:count':
        out((string)RememberDevice::activeCount());
        break;

    case 'device:revoke-all':
        $u = (string)($argvIn[0] ?? '');
        if ($u === '') {
            out('Error: usage: device:revoke-all <username>');
            exit(2);
        }
        out('OK ' . (string)RememberDevice::revokeAll($u) . ' devices revoked');

    case 'offsite:status':
        $c = Offsite::config();
        if (!$c['configured']) {
            out('NOT CONFIGURED: ' . (string)$c['error']);
            break;
        }
        $s = Offsite::status();
        out('endpoint : ' . (string)$c['endpoint']);
        out('bucket   : ' . (string)$c['bucket']);
        out('region   : ' . (string)$c['region']);
        out('key id   : ' . (string)$c['key_id']);
        out('reachable: ' . (!empty($s['reachable']) ? 'yes' : 'NO'));
        out('archives : ' . (string)($s['remote'] ?? 0));
        out('latest   : ' . (string)($s['latest_remote'] ?? '-'));
        if (!$s['reachable']) {
            out('error    : ' . (string)($s['error'] ?? '-'));
            exit(1);
        }
        break;

    case 'offsite:upload':
        // Backups are encrypted before being sent; the .enc file in the bucket cannot
        // be read by anyone who only has access to the storage.
        $name = (string)($argvIn[0] ?? '');
        if ($name === '') {
            // Without a name: use the latest archive available.
            $name = Backup::latestName();
        }
        if ($name === '') {
            out('Error: no backup archive to upload');
            exit(1);
        }
        $r = Offsite::upload('/var/backups/fpanel/' . $name, $name);
        if (!$r['ok']) {
            out('Error: ' . (string)$r['error']);
            exit(1);
        }
        out('OK ' . (string)$r['message']);
        break;

    case 'offsite:decrypt':
        $enc = (string)($argvIn[0] ?? '');
        $dest = (string)($argvIn[1] ?? '');
        if ($enc === '' || $dest === '') {
            out('Error: usage: offsite:decrypt <file.enc> <destination>');
            exit(2);
        }
        if (!is_file($enc)) {
            out('Error: file not found: ' . $enc);
            exit(1);
        }
        if (!Offsite::decryptFile($enc, $dest)) {
            out('Error: decryption failed (MAC mismatch or wrong key)');
            exit(1);
        }
        out('OK decrypted to ' . $dest);
        break;

    case 'offsite:prune':
        $r = Offsite::pruneRemote((int)($argvIn[0] ?? Offsite::KEEP));
        if (!$r['ok']) {
            out('Error: ' . (string)$r['error']);
            exit(1);
        }
        out('OK ' . (string)$r['message']);
        break;

    case 'housekeeping:dry':
        $r = Housekeeping::make()->run(true);
        if (!$r['ok']) {
            out('Error: ' . (string)$r['error']);
            exit(1);
        }
        foreach ($r['counts'] as $k => $n) {
            out('will be deleted ' . $k . ': ' . (string)$n);
        }
        break;

    case 'housekeeping:run':
        $r = Housekeeping::make()->run(false);
        if (!$r['ok']) {
            out('Error: ' . (string)$r['error']);
            exit(1);
        }
        $parts = [];
        foreach ($r['counts'] as $k => $n) {
            $parts[] = $k . '=' . (string)$n;
        }
        foreach ($r['warnings'] as $w) {
            out('WARNING: ' . $w);
        }
        out('OK cleaned up: ' . implode(' ', $parts));
        break;

    case 'usage:collect':
        $r = Usage::collect();
        if (!$r['ok']) {
            out('Error: ' . (string)$r['error']);
            exit(1);
        }
        out('OK ' . (string)$r['message']);
        break;

    case 'wp:update':
        // Background worker for core/plugin/theme updates. This CLI is not
        // called from the browser; Wp::startUpdate() calls it.
        $r = Wp::runUpdate(Wp::decodePayload((string)($argvIn[0] ?? '')) ?? []);
        if (!$r['ok']) {
            out('Error: ' . (string)$r['error']);
            exit(1);
        }
        out('OK ' . (string)$r['message']);
        break;

    case 'wp:install':
        // Called from Wp::spawn() with a base64url payload. The installer
        // deliberately runs in the CLI so it is not bound by FPM max_execution_time.
        // Important: the CLI shifts off the script name and command name, so the
        // first argument is in $argvIn[0]. $argv[1] holds "wp:install" itself.
        $args = Wp::decodePayload((string)($argvIn[0] ?? ''));
        if (!isset($args['username'], $args['domain'])) {
            out('Error: invalid wp:install payload');
            exit(1);
        }
        $r = Wp::runInstall($args);
        if (!$r['ok']) {
            out('Error: ' . (string)$r['error']);
            exit(1);
        }
        out('OK ' . (string)$r['message']);
        break;

    case 'pma:sweep':
        $gone = PhpMyAdmin::sweep();
        out((string)$gone);
        break;

    default:
        out("fpanel CLI
  user:create <username> <password> <email> [admin|user]
  user:pass <username> <password>
  user:delete <username>
  user:list
  db:migrate | db:reset | db:migrate-ssl | db:migrate-ini | db:migrate-usage | db:migrate-totp | db:migrate-devices | db:migrate-domain-type\n  php:prep | pma:sweep | usage:collect\n  housekeeping:dry | housekeeping:run | totp:encrypt-secrets\n  login-link:issue <user> | login-link:count | device:count | device:revoke-all <user>\n  offsite:status | offsite:upload [name] | offsite:decrypt <enc> <destination> | offsite:prune [count]\n  wp:install <payload> | wp:update <payload> | backup:create | backup:list | backup:verify | backup:delete | backup:prune\n  domain:id <name> | domain:count [user] | domain:exists <pattern>");
        exit(1);
}
